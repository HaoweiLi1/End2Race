__pycache__

build/
install/
.vscode/
.claude/
.codex/
.agents/
Dataset_*/
/artifacts/sb3_nonzero_smoke/
eval_results/
/runs/ppo_v1/*/checkpoints/

# PPO V1.2 lightweight experiment evidence is intentionally reviewable.
# Keep model/checkpoint payloads and raw files larger than 1 MiB out of Git.
/runs/ppo_v1_2/**/checkpoints/
/runs/ppo_v1_2/**/*.pth
/runs/ppo_v1_2/**/*.pt
/runs/ppo_v1_2/**/*.ckpt
/runs/ppo_v1_2/**/*.onnx
/runs/ppo_v1_2/**/*.zip
/runs/ppo_v1_2/hard_pools/H2_pass1_rows.jsonl
/runs/ppo_v1_2/hard_pools/expanded_valid.json
/runs/ppo_v1_2/hard_pools/H1_rows.json
/runs/ppo_v1_2/hard_pools/H1_rows.jsonl
/runs/ppo_v1_2/hard_pools/expanded_candidates.json
/runs/ppo_v1_2/hard_pools/H2_rows.json

# Transient orchestration files are not experiment results.
/runs/ppo_v1_2/SWEEP.lock
/runs/ppo_v1_2/unattended_runner.log

# PPO V1.2 compact two-device evidence follows the same review policy.
/runs/ppo_v1_2_compact/**/checkpoints/
/runs/ppo_v1_2_compact/**/*.pth
/runs/ppo_v1_2_compact/**/*.pt
/runs/ppo_v1_2_compact/**/*.ckpt
/runs/ppo_v1_2_compact/**/*.onnx
/runs/ppo_v1_2_compact/**/*.zip
/runs/ppo_v1_2_compact/**/SWEEP.lock
/runs/ppo_v1_2_compact/**/unattended_runner.log
